{
  "name": "storybook",
  "version": "1.0.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "export $(grep -e '^STORYBOOK_PORT' -- ../../.env) && storybook dev -p ${STORYBOOK_PORT} --no-open",
    "build-storybook": "sb build",
    "lint": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@chromatic-com/storybook": "5.3.0",
    "@if/tooling": "*",
    "@storybook/addon-styling-webpack": "3.0.2",
    "@storybook/cli": "10.5.7",
    "@storybook/nextjs": "10.5.7",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
